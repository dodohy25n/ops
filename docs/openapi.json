  "components": {
    "schemas": {
      "BaselineMetrics": {
        "properties": {
          "period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          },
          "f2": {
            "type": "number",
            "title": "F2"
          },
          "precision": {
            "type": "number",
            "title": "Precision"
          },
          "recall": {
            "type": "number",
            "title": "Recall"
          },
          "pr_auc": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pr Auc"
          },
          "alert_rate": {
            "type": "number",
            "title": "Alert Rate"
          },
          "fraud_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fraud Rate"
          }
        },
        "type": "object",
        "required": [
          "period",
          "f2",
          "precision",
          "recall",
          "pr_auc",
          "alert_rate",
          "fraud_rate"
        ],
        "title": "BaselineMetrics"
      },
      "BatchRequest": {
        "properties": {
          "upload_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Upload Id",
            "description": "/data/upload가 반환한 ID"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date",
            "description": "판정 시작일. 앞선 CSV 행은 이력으로 사용합니다."
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          }
        },
        "type": "object",
        "required": [
          "upload_id"
        ],
        "title": "BatchRequest"
      },
      "BatchSummary": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "model_role": {
            "type": "string",
            "title": "Model Role"
          },
          "tau": {
            "type": "number",
            "title": "Tau"
          },
          "input_rows": {
            "type": "integer",
            "title": "Input Rows"
          },
          "period_rows": {
            "type": "integer",
            "title": "Period Rows"
          },
          "predictions": {
            "type": "integer",
            "title": "Predictions"
          },
          "excluded_rows": {
            "type": "integer",
            "title": "Excluded Rows"
          },
          "alerts": {
            "type": "integer",
            "title": "Alerts"
          },
          "alert_rate": {
            "type": "number",
            "title": "Alert Rate"
          },
          "labelled_predictions": {
            "type": "integer",
            "title": "Labelled Predictions"
          },
          "metrics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QualityMetrics"
              },
              {
                "type": "null"
              }
            ]
          },
          "start_date": {
            "type": "string",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "title": "End Date"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "transactions_per_second": {
            "type": "number",
            "title": "Transactions Per Second"
          },
          "monitoring": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MonitoringUpdate"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "upload_id",
          "filename",
          "created_at",
          "model_version",
          "model_role",
          "tau",
          "input_rows",
          "period_rows",
          "predictions",
          "excluded_rows",
          "alerts",
          "alert_rate",
          "labelled_predictions",
          "metrics",
          "start_date",
          "end_date",
          "duration_seconds",
          "transactions_per_second"
        ],
        "title": "BatchSummary"
      },
      "Body_upload_data_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_data_upload_post"
      },
      "DataStatus": {
        "properties": {
          "exists": {
            "type": "boolean",
            "title": "Exists"
          },
          "latest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UploadSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "exists",
          "latest"
        ],
        "title": "DataStatus"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "GateCriteria": {
        "properties": {
          "recall_min": {
            "type": "number",
            "title": "Recall Min"
          },
          "alert_rate_max": {
            "type": "number",
            "title": "Alert Rate Max"
          },
          "min_samples": {
            "type": "integer",
            "title": "Min Samples"
          },
          "min_frauds": {
            "type": "integer",
            "title": "Min Frauds"
          }
        },
        "type": "object",
        "required": [
          "recall_min",
          "alert_rate_max",
          "min_samples",
          "min_frauds"
        ],
        "title": "GateCriteria"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "model_loaded": {
            "type": "boolean",
            "title": "Model Loaded"
          },
          "loading_mode": {
            "type": "string",
            "enum": [
              "lazy",
              "eager"
            ],
            "title": "Loading Mode"
          },
          "model": {
            "$ref": "#/components/schemas/ModelState"
          }
        },
        "type": "object",
        "required": [
          "status",
          "model_loaded",
          "loading_mode",
          "model"
        ],
        "title": "HealthResponse"
      },
      "LogContent": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          }
        },
        "type": "object",
        "required": [
          "name",
          "content",
          "truncated"
        ],
        "title": "LogContent"
      },
      "LogFile": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          }
        },
        "type": "object",
        "required": [
          "name",
          "size"
        ],
        "title": "LogFile"
      },
      "ModelCriteria": {
        "properties": {
          "beta": {
            "type": "number",
            "title": "Beta"
          },
          "tau": {
            "type": "number",
            "title": "Tau"
          },
          "baseline": {
            "$ref": "#/components/schemas/BaselineMetrics"
          },
          "gate": {
            "$ref": "#/components/schemas/GateCriteria"
          },
          "trigger": {
            "$ref": "#/components/schemas/TriggerCriteria"
          },
          "psi": {
            "$ref": "#/components/schemas/PsiCriteria"
          }
        },
        "type": "object",
        "required": [
          "beta",
          "tau",
          "baseline",
          "gate",
          "trigger",
          "psi"
        ],
        "title": "ModelCriteria",
        "description": "모델 버전과 함께 저장된 판정 기준. 배포 게이트는 후보 심사용, 트리거는 운영 감시용입니다."
      },
      "ModelState": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "loaded",
              "unloaded",
              "unavailable"
            ],
            "title": "State"
          },
          "source": {
            "type": "string",
            "enum": [
              "local",
              "mlflow"
            ],
            "title": "Source"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "tau": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tau"
          },
          "role": {
